<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#FFFFFF"
    >
    <ImageView
        android:id="@+id/statusbar"
        android:layout_width="412dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:src="@drawable/status_bar"
        tools:ignore="MissingConstraints">
    </ImageView>
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="나의 운동기록\n시작하기"
        android:textSize="24sp"
        android:fontFamily="@font/prendard_semilbold"

        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/statusbar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="200dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="105dp"/>

    <TextView
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="간편하게 로그인하고 운동일지를 공유해보세요"
        android:textSize="15sp"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="#8E97A4"
        android:layout_marginTop="4dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/btn_google_login"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/google_shape"
        app:layout_constraintTop_toBottomOf="@id/sub_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints">

        <!-- 로고: 왼쪽에서 18dp 여백 -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="18dp"
            android:src="@drawable/google_logo" />

        <!-- 텍스트: 버튼 전체 영역 내에서 중앙 정렬 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Google 로그인하기"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular" />

        <!-- 오른쪽 여백을 위해 투명한 뷰 추가 (로고 크기만큼) -->
        <View
            android:layout_width="42dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView
        android:id="@+id/text_policy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/policy_guide"
        android:textSize="14sp"
        android:textColor="#8E97A4"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>