<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:left="4dp" android:right="4dp" android:top="6dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#02000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <item android:left="3dp" android:right="3dp" android:top="5dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#04000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <item android:left="2dp" android:right="2dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#06000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>

            <corners android:radius="30dp"/>

            <stroke
                android:width="0.8dp"
                android:color="#EAECEF"/>
        </shape>
    </item>
</layer-list>