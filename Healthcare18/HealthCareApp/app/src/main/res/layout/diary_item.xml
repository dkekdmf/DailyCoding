<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <View
        android:id="@+id/view_dashed_line2"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/divide_sun"
        android:layerType="software"
        app:layout_constraintBottom_toTopOf="@id/cardview_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_item"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="16dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <View
                android:id="@+id/view_stripe"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#FF69B4"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="26.04.08"
                android:textColor="#2E3D4F"

                android:textSize="16sp"

                app:layout_constraintTop_toTopOf="@id/exercise_dot"
                app:layout_constraintBottom_toBottomOf="@id/exercise_dot"

                app:layout_constraintStart_toEndOf="@id/view_stripe" />

            <TextView
                android:id="@+id/tv_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="개인운동"
                android:textColor="#8896A8"
                android:textSize="13sp"

                app:layout_constraintTop_toBottomOf="@id/tv_date"
                app:layout_constraintStart_toStartOf="@+id/tv_date" />

            <ImageView
                android:id="@+id/iv_diary_photo_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"

                android:src="@drawable/pic23x"
                app:layout_constraintBottom_toBottomOf="@id/exercise_dot"
                app:layout_constraintEnd_toStartOf="@id/exercise_dot"
                app:layout_constraintTop_toTopOf="@id/exercise_dot" />
            <ImageView
                android:id="@+id/diaryemoticon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:layout_constraintTop_toBottomOf="@id/exercise_dot"
                app:layout_constraintStart_toStartOf="@id/exercise_dot"

                android:layout_marginTop="4dp"
                android:src="@drawable/emoticon11"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/exercise_dot" />
            <ImageView
                android:id="@+id/exercise_dot"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/dot3x"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <View
        android:id="@+id/view_dashed_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/divide_sun"
        android:layerType="software"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardview_item" />
</androidx.constraintlayout.widget.ConstraintLayout>