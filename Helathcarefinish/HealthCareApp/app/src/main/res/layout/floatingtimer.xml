<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:elevation="0dp"
    android:background="@drawable/bg_white_round"
    android:paddingHorizontal="18dp">

    <TextView
        android:id="@+id/tv_bar_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textColor="#181818"
        android:textSize="28sp"
        android:fontFamily="@font/pretendard_black"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_bar_pause"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/pause"
        app:layout_constraintBottom_toBottomOf="@id/tv_bar_time"
        app:layout_constraintEnd_toStartOf="@id/btn_bar_finish"
        app:layout_constraintTop_toTopOf="@id/tv_bar_time"
        android:layout_marginEnd="16dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_bar_finish"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"

        android:stateListAnimator="@null"
        android:background="@drawable/bg_gray_round"

        android:text="운동 마치기"
        android:textColor="#2E3D4F"
        android:textSize="13sp"
        android:fontFamily="@font/prendard_semilbold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>